# Required for AI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required for account authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enable hosted web search with a compatible OpenAI model
ENABLE_WEB_SEARCH=false
# Optional: fine-grained GitHub token with read-only repository permissions
GITHUB_TOKEN=
# Optional: write token for allowlisted GitHub actions after explicit approval
GITHUB_WRITE_TOKEN=
